{
  "expo": {
    "name": "Kawan Model",
    "slug": "kawanmodel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kawan-model-transparent.png",
    "scheme": "kawanmodel",
    "owner": "zidanherlangga",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kawanmodel.aiclient",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Izinkan $(PRODUCT_NAME) menggunakan pengenalan suara.",
        "NSMicrophoneUsageDescription": "Izinkan $(PRODUCT_NAME) menggunakan mikrofon untuk input suara."
      }
    },
    "android": {
      "package": "com.kawanmodel.aiclient",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kawan-model-transparent.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kawan-model.png",
          "imageWidth": 600,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Izinkan $(PRODUCT_NAME) menggunakan mikrofon untuk input suara.",
          "speechRecognitionPermission": "Izinkan $(PRODUCT_NAME) menggunakan pengenalan suara."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan $(PRODUCT_NAME) mengakses galeri untuk melampirkan gambar.",
          "cameraPermission": "Izinkan $(PRODUCT_NAME) menggunakan kamera untuk mengambil foto."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8688a42-45d4-451d-abc1-cc208eb9d23c"
      }
    }
  }
}
